# =============================================================================
# SriPon Backend — Environment Configuration
# Copy to .env and fill in real values. NEVER commit the real .env file.
# =============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed browser origins (no trailing slash).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Used to sign short-lived internal tokens (e.g. payment/webhook helpers).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Database (Supabase PostgreSQL) ----------------------------------------
# Pooled connection used at runtime.
DATABASE_URL=postgres://postgres:password@db.example.supabase.co:5432/postgres
# Direct connection used for migrations.
DIRECT_DATABASE_URL=postgres://postgres:password@db.example.supabase.co:6543/postgres

# --- Redis (Render / Upstash / any Redis) -----------------------------------
REDIS_URL=redis://localhost:6379

# --- Firebase (customer authentication) -------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional: path to a service-account JSON file. Preferred over the two values
# above in local development. Not used in production envs are preferred.
# FIREBASE_SERVICE_ACCOUNT_PATH=

# --- Supabase (admin authentication) ----------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudinary (media) ------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Payments (provider-independent; configure the active provider) ----------
PAYMENT_PROVIDER=
PAYMENT_MERCHANT_ID=
PAYMENT_CLIENT_ID=
PAYMENT_CLIENT_SECRET=
PAYMENT_SALT_KEY=
# Public callback URL the payment gateway must send webhooks to.
# PAYMENT_WEBHOOK_URL=