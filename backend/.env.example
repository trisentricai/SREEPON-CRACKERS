# =============================================================================
# SriPon Backend - Production Environment Configuration
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit the real .env file.
# Secrets are set as encrypted Cloudflare Worker secrets (wrangler secret put)
# or Render environment variables (dashboard), never in this file.
# =============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=production
PORT=10000
DEPLOY_TARGET=workers

# --- CORS ------------------------------------------------------------------
# Comma-separated list of allowed browser origins (no trailing slash).
# Include your deployed web storefront, admin dashboard, and any preview URLs.
CORS_ORIGINS=https://sreepon.in,https://www.sreepon.in,https://sreepon-crackers.pages.dev,https://sreeponweb.onrender.com,https://sreepon-admin.netlify.app,https://sreepon-admin.pages.dev

# When "true", requires X-CSRF-Token header on state-changing requests.
CSRF_REQUIRE_TOKEN=false

# JWT secret used to sign short-lived internal tokens (payment/webhook helpers).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Database (Supabase PostgreSQL) ----------------------------------------
# Pooled connection used at runtime (Node/Render). Workers use this too via Prisma adapter.
DATABASE_URL=postgres://postgres:password@db.example.supabase.co:5432/postgres

# Direct connection used for migrations and pg_dump/pg_restore backups.
DIRECT_DATABASE_URL=postgres://postgres:password@db.example.supabase.co:6543/postgres

# --- Redis (Render / Upstash / any Redis) -----------------------------------
REDIS_URL=redis://localhost:6379

# Upstash Redis REST API - REQUIRED on Cloudflare Workers (raw TCP Redis unavailable).
# Get both from https://console.upstash.com/redis/<uuid>.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Firebase (customer authentication) -------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional: path to a service-account JSON file (local dev only).
# FIREBASE_SERVICE_ACCOUNT_PATH=
# Redirect target for Firebase-generated password-reset links.
FIREBASE_PASSWORD_RESET_URL=
# Firebase Web API key (public). Required for Identity Toolkit revocation lookups on Workers.
FIREBASE_API_KEY=
# When "true", checks Firebase ID token revocation via Identity Toolkit on every
# authenticated request (adds ~1 network round-trip). Opt-in.
FIREBASE_CHECK_REVOCATION=false

# --- Supabase (admin authentication) ----------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudinary (media) -----------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Payments (provider-independent; configure the active provider) ---------
PAYMENT_PROVIDER=cashfree
PAYMENT_MERCHANT_ID=
PAYMENT_CLIENT_ID=
PAYMENT_CLIENT_SECRET=
PAYMENT_SALT_KEY=
# Public callback URL the payment gateway must send webhooks to.
PAYMENT_WEBHOOK_URL=https://sreepon-api.trisentricai.workers.dev/api/v1/payments/webhooks/cashfree

# --- Cashfree (live gateway) ------------------------------------------------
# Dashboard -> Developers -> API Keys. Sandbox credentials only work with
# CASHFREE_ENV=sandbox; production live keys need CASHFREE_ENV=production.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
# Public storefront origin used to build the gateway return URL.
PUBLIC_BASE_URL=https://sreepon.in

# --- Stripe (alternative gateway, not currently active) ---------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Scheduled maintenance --------------------------------------------------
# Unpaid online orders older than this are cancelled by the 30-minute cron job
# and their reserved stock is released. COD orders are never expired.
# Default: 1440 (24 hours).
ORDER_PAYMENT_WINDOW_MINUTES=1440
