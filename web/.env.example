# =============================================================================
# SriPon Web Storefront - Production Environment Configuration
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit the real .env file.
# Vite exposes only VITE_* variables to the client bundle. Secrets must never
# be embedded here - they live only on the backend.
# =============================================================================

# --- Vite (auto-prefixed, do not change) ----------------------------------
MODE=production
DEV=false
PROD=true
BASE_URL=/
SSR=false

# --- API -------------------------------------------------------------------
# Public backend base URL. Points to the live Cloudflare Workers API in production.
VITE_API_BASE_URL=https://sreepon-api.trisentricai.workers.dev/api/v1

# --- Firebase (customer auth) ----------------------------------------------
# These are public configuration values - safe to embed in the client bundle.
# Get them from Firebase Console -> Project Settings -> General -> Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
