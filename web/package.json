{
  "name": "@sripon/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SriPon customer website — React + Vite + TypeScript + Tailwind, Firebase authentication.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
