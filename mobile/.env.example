# =============================================================================
# SriPon Flutter Mobile App - Production Environment Configuration
# =============================================================================
# Values are injected at build time via `flutter run --dart-define=KEY=value`
# or `flutter build apk --dart-define=KEY=value`. Nothing here is a secret -
# secrets live only on the backend.
# =============================================================================

# --- API -------------------------------------------------------------------
# Public backend base URL. Points to the live Cloudflare Workers API in production.
API_BASE_URL=https://sreepon-api.trisentricai.workers.dev/api/v1

# --- Firebase (customer auth) ----------------------------------------------
# Set to "true" to enable Firebase Auth in the mobile app.
FIREBASE_AUTH_ENABLED=false

# Example build commands:
#   flutter run --dart-define=API_BASE_URL=https://sreepon-api.trisentricai.workers.dev/api/v1 --dart-define=FIREBASE_AUTH_ENABLED=false
#   flutter build apk --release --dart-define=API_BASE_URL=https://sreepon-api.trisentricai.workers.dev/api/v1 --dart-define=FIREBASE_AUTH_ENABLED=false
